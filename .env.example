# Copy to .env for local runs. Never commit .env.
SERVICE_NAME=fde-00-programming
ENVIRONMENT=local
LOG_LEVEL=INFO

# Database. Local Python default is SQLite (artifacts/complaints.db).
# Compose, Podman and Kubernetes run Postgres 16 and set DATABASE_URL themselves.
# DATABASE_URL=postgresql+psycopg://complaints:complaints-local@127.0.0.1:5432/complaints
POSTGRES_PASSWORD=complaints-local

# CFPB ingest defaults used by the Compose `ingest` job
INGEST_DAYS=7
INGEST_LIMIT=5000

# Host port the desktop stacks publish on (127.0.0.1 only)
HOST_PORT=8000

# LLM provider settings are kept for later phases; this repo makes no LLM calls.
LLM_PROVIDER=mistral
MISTRAL_API_KEY=
